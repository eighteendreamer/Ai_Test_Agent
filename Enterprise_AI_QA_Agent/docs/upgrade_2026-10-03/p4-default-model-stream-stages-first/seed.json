      "target_release": "尚无部署证据",
      "provenance": "user_declared",
      "deployment_status": "unknown"
    },
    "token_measurement": "not_available"
  },
  "batch_settings": {
    "scope_key": "global",
    "revision": 1,
    "payload": {
      "max_segment_chars": 12000,
      "max_segments": 10000,
      "boundary_context_chars": 500,
      "max_retrieval_bytes": 256000
    }
  },
  "invocation_snapshot": {
    "config": {
      "scope_key": "global",
      "revision": 1,
      "payload": {
        "max_logical_calls": 200,
        "max_reserved_estimated_tokens": 2000000,
        "call_timeout_seconds": 120.0,
        "max_response_bytes": 8000000,
        "token_method": "utf8_bytes_estimate",
        "encoding_name": null,
        "framing_allowance_tokens": 1024
      }
    },
    "tokenizer_version": null,
    "runtime_parameters": {
      "sdk_retry_policy": "existing_provider_defaults",
      "dependency_versions": {
        "openai": "3.14.0"
      },
      "llm_request_timeout_seconds": 60.0,
      "langchain_model_adapter_enabled": false
    }
  },
  "response_protocol": {
    "version": "impact-call-v4",
    "scope": "one declared unit only",
    "response_schema": {
      "type": "object",
      "$defs": {
        "BoundRangeRead": {
          "type": "object",
          "title": "BoundRangeRead",
          "required": [
            "source_ref",
            "start_char",
            "end_char"
          ],
          "properties": {
            "end_char": {
              "type": "integer",
              "title": "End Char",
              "minimum": 0
            },
            "source_ref": {
              "type": "string",
              "title": "Source Ref",
              "pattern": "^S[1-9][0-9]*$"
            },
            "start_char": {
              "type": "integer",
              "title": "Start Char",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "BoundReadRequest": {
          "type": "object",
          "title": "BoundReadRequest",
          "properties": {
            "ranges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundRangeRead"
              },
              "title": "Ranges",
              "maxItems": 100
            },
            "case_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^C[1-9][0-9]*$"
              },
              "title": "Case Refs",
              "maxItems": 100
            },
            "segment_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^P[1-9][0-9]*$"
              },
              "title": "Segment Refs",
              "maxItems": 100
            },
            "difference_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^D[1-9][0-9]*$"
              },
              "title": "Difference Refs",
              "maxItems": 100
            }
          },
          "additionalProperties": false
        },
        "BoundCaseCitation": {
          "type": "object",
          "title": "BoundCaseCitation",
          "required": [
            "value"
          ],
          "properties": {
            "path": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "title": "Path"
            },
            "root": {
              "enum": [
                "content_json",
                "execution_notes"
              ],
              "type": "string",
              "title": "Root",
              "default": "content_json"
            },
            "value": {
              "title": "Value"
            }
          },
          "additionalProperties": false
        },
        "BoundTextCitation": {
          "type": "object",
          "title": "BoundTextCitation",
          "required": [
            "source_ref",
            "start_char",
            "end_char",
            "quote"
          ],
          "properties": {
            "quote": {
              "type": "string",
              "title": "Quote",
              "minLength": 1
            },
            "end_char": {
              "type": "integer",
              "title": "End Char",
              "minimum": 0
            },
            "source_ref": {
              "type": "string",
              "title": "Source Ref",
              "pattern": "^S[1-9][0-9]*$"
            },
            "start_char": {
              "type": "integer",
              "title": "Start Char",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "BoundCaseCandidate": {
          "type": "object",
          "title": "BoundCaseCandidate",
          "required": [
            "case_ref",
            "level",
            "reason",
            "citations"
          ],
          "properties": {
            "level": {
              "enum": [
                "none",
                "minor",
                "major",
                "uncertain"
              ],
              "type": "string",
              "title": "Level"
            },
            "reason": {
              "type": "string",
              "title": "Reason",
              "minLength": 1
            },
            "case_ref": {
              "type": "string",
              "title": "Case Ref",
              "pattern": "^C[1-9][0-9]*$"
            },
            "citations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundCaseCitation"
              },
              "title": "Citations",
              "minItems": 1
            },
            "verification_points": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "Verification Points"
            }
          },
          "additionalProperties": false
        },
        "BoundRuleCandidate": {
          "type": "object",
          "title": "BoundRuleCandidate",
          "required": [
            "key",
            "kind",
            "summary",
            "reason",
            "document_citations"
          ],
          "properties": {
            "key": {
              "type": "string",
              "title": "Key",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "added",
                "modified",
                "removed",
                "uncertain"
              ],
              "type": "string",
              "title": "Kind"
            },
            "reason": {
              "type": "string",
              "title": "Reason",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "title": "Summary",
              "minLength": 1
            },
            "case_impacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundCaseCandidate"
              },
              "title": "Case Impacts"
            },
            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "title": "Uncertainties"
            },
            "document_citations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundTextCitation"
              },
              "title": "Document Citations",
              "minItems": 1
            },
            "applicability_suggestion": {
              "enum": [
                "unknown",
                "current",
                "future"
              ],
              "type": "string",
              "title": "Applicability Suggestion",
              "default": "unknown"
            }
          },
          "additionalProperties": false
        },
        "BoundRuleCaseAssessment": {
          "type": "object",
          "title": "BoundRuleCaseAssessment",
          "required": [
            "rule_ref",
            "case_impacts"
          ],
          "properties": {
            "rule_ref": {
              "type": "string",
              "title": "Rule Ref",
              "pattern": "^R[1-9][0-9]*$"
            },
            "case_impacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundCaseCandidate"
              },
              "title": "Case Impacts",
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "title": "DocumentImpactBoundDecision",
      "required": [
        "protocol_version",
        "action",
        "summary"
      ],
      "properties": {
        "reads": {
          "$ref": "#/$defs/BoundReadRequest"
        },
        "action": {
          "enum": [
            "read",
            "finish"
          ],
          "type": "string",
          "title": "Action"
        },
        "summary": {
          "type": "string",
          "title": "Summary",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/BoundRuleCandidate"
              },
              {
                "$ref": "#/$defs/BoundRuleCaseAssessment"
              }
            ]
          },
          "title": "Candidates"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Unresolved"
        },
        "unit_outcome": {
          "anyOf": [
            {
              "enum": [
                "analyzed",
                "evidence_insufficient"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Outcome",
          "default": null
        },
        "protocol_version": {
          "type": "string",
          "const": "impact-response-v2",
          "title": "Protocol Version"
        }
      },
      "additionalProperties": false
    },
    "instruction": "Return one impact-response-v2 JSON object using this response_schema. The saved call owns the current unit; do not output a unit, UUID or hash. Use only short references in fixed_references: S for sources, P for segments, C for cases, D for differences. For action=read supply short references/ranges with no final outcome or candidates; for finish supply unit_outcome/candidates/unresolved with no pending reads. Discovery candidates cite exact supplied original slices; positions are original character offsets, not normalized diff offsets. Case citations use literal JSON paths and actual values from a complete case supplied in this message history. Catalogs are not read evidence. During coordination stage case_impacts, candidates are BoundRuleCaseAssessment objects with rule_ref R1 etc. and case_impacts; assess every fixed rule for the current complete case. The server preserves the fixed rule body and binds identities/hashes before fact checks. Canonical identities mentioned in coordination instructions are internal; this response_schema defines the model reply. Do not rewrite those identities or copy hashes. Request fixed reads for cross-section/missing evidence. Keep intentional negative conditions. Applicability is a suggestion, deployment unknown, all candidates pending review. Do not claim full project coverage or execute/change official records.",
    "sha256": "1153d64ff0fffe0b510e148334e31b5361880c660d67c695b957a57f3bc91e42"
  },
  "workflow_protocol": {
    "version": "impact-coordinator-v1",
    "discovery_instruction": "本阶段从固定原文及差异提出规则变化候选。只处理当前单元，可read补读。候选引用实际读取的原文；不是需求评审。依据不足保留evidence_insufficient和unresolved。",
    "case_instruction": "本阶段将rules中完整规则候选与当前完整固定用例及其编写来源比较。逐条返回candidate，key必须为对应rules.id，保留该规则的kind/summary及原文依据，case_impacts仅判断当前unit.id，每条说明none/minor/major/uncertain并引用当前用例实际字段。需要原文或来源时read补读。不得遗漏规则后声明analyzed；无法判断保留evidence_insufficient。discovery_units包含未完成范围时不能宣称完整或无变化。没有规则仍判断本用例来源是否充分。所有候选仍待评审，不能将模型建议当作部署事实或测试通过。",
    "sha256": "76f3c582a070c4b136e1e629ecdea508f0f1fe814e4a8dbd917180ca9051f5b5"
  },
  "implementation_version": "impact-sources-v2"
}