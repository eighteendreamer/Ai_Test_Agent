    "response_protocol": {
      "version": "impact-call-v5",
      "scope": "one declared unit only",
      "response_schema": {
        "type": "object",
        "$defs": {
          "BoundRangeRead": {
            "type": "object",
            "title": "BoundRangeRead",
            "required": [
              "source_ref",
              "start_char",
              "end_char"
            ],
            "properties": {
              "end_char": {
                "type": "integer",
                "title": "End Char",
                "minimum": 0
              },
              "source_ref": {
                "type": "string",
                "title": "Source Ref",
                "pattern": "^S[1-9][0-9]*$"
              },
              "start_char": {
                "type": "integer",
                "title": "Start Char",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "BoundReadRequest": {
            "type": "object",
            "title": "BoundReadRequest",
            "properties": {
              "ranges": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundRangeRead"
                },
                "title": "Ranges",
                "maxItems": 100
              },
              "case_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C[1-9][0-9]*$"
                },
                "title": "Case Refs",
                "maxItems": 100
              },
              "segment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^P[1-9][0-9]*$"
                },
                "title": "Segment Refs",
                "maxItems": 100
              },
              "difference_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^D[1-9][0-9]*$"
                },
                "title": "Difference Refs",
                "maxItems": 100
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCitation": {
            "type": "object",
            "title": "BoundCaseCitation",
            "required": [
              "value"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "title": "Path"
              },
              "root": {
                "enum": [
                  "content_json",
                  "execution_notes"
                ],
                "type": "string",
                "title": "Root",
                "default": "content_json"
              },
              "value": {
                "title": "Value"
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCandidate": {
            "type": "object",
            "title": "BoundCaseCandidate",
            "required": [
              "case_ref",
              "level",
              "reason",
              "citations"
            ],
            "properties": {
              "level": {
                "enum": [
                  "none",
                  "minor",
                  "major",
                  "uncertain"
                ],
                "type": "string",
                "title": "Level"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "case_ref": {
                "type": "string",
                "title": "Case Ref",
                "pattern": "^C[1-9][0-9]*$"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCitation"
                },
                "title": "Citations",
                "minItems": 1
              },
              "verification_points": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Verification Points"
              }
            },
            "additionalProperties": false
          },
          "AnchoredRuleCandidate": {
            "type": "object",
            "title": "AnchoredRuleCandidate",
            "required": [
              "key",
              "kind",
              "summary",
              "reason",
              "document_citations"
            ],
            "properties": {
              "key": {
                "type": "string",
                "title": "Key",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "uncertain"
                ],
                "type": "string",
                "title": "Kind"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "title": "Summary",
                "minLength": 1
              },
              "case_impacts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCandidate"
                },
                "title": "Case Impacts"
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Uncertainties"
              },
              "document_citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^T[1-9][0-9]*$"
                },
                "title": "Document Citations",
                "minItems": 1
              },
              "applicability_suggestion": {
                "enum": [
                  "unknown",
                  "current",
                  "future"
                ],
                "type": "string",
                "title": "Applicability Suggestion",
                "default": "unknown"
              }
            },
            "additionalProperties": false
          },
          "BoundRuleCaseAssessment": {
            "type": "object",
            "title": "BoundRuleCaseAssessment",
            "required": [
              "rule_ref",
              "case_impacts"
            ],
            "properties": {
              "rule_ref": {
                "type": "string",
                "title": "Rule Ref",
                "pattern": "^R[1-9][0-9]*$"
              },
              "case_impacts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCandidate"
                },
                "title": "Case Impacts",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "title": "DocumentImpactAnchoredDecision",
        "required": [
          "protocol_version",
          "action",
          "summary"
        ],
        "properties": {
          "reads": {
            "$ref": "#/$defs/BoundReadRequest"
          },
          "action": {
            "enum": [
              "read",
              "finish"
            ],
            "type": "string",
            "title": "Action"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "minLength": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnchoredRuleCandidate"
                },
                {
                  "$ref": "#/$defs/BoundRuleCaseAssessment"
                }
              ]
            },
            "title": "Candidates"
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Unresolved"
          },
          "unit_outcome": {
            "anyOf": [
              {
                "enum": [
                  "analyzed",
                  "evidence_insufficient"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Outcome",
            "default": null
          },
          "protocol_version": {
            "type": "string",
            "const": "impact-response-v3",
            "title": "Protocol Version"
          }
        },
        "additionalProperties": false
      },
      "instruction": "Return one impact-response-v3 JSON object using this response_schema. The saved call owns the unit and formal identities. Use short S/P/C/D references for reads. In discovery, document_citations is a list of T references from fixed_text_evidence; select supplied original text, never calculate/copy offsets, quotes, UUIDs or hashes. The server binds each T to its exact original text/position/hash and verifies it. T entries are actual text evidence, other catalogs are retrieval metadata. For action=read supply reads with no final candidates/outcome; for finish provide unit_outcome/candidates/unresolved with no pending reads. During case_impacts return BoundRuleCaseAssessment: rule_ref R1 etc. plus case_impacts for every supplied fixed rule. The server retains each original rule and its citations. Case citations use literal JSON paths and actual values from a supplied complete case. Keep intentional negative conditions. Request fixed reads for missing/cross-section evidence. All candidates need review, deployment remains unknown; do not claim full coverage or execute/change official records. This schema defines the wire reply, canonical identities mentioned in coordination instructions belong to the server.",
      "sha256": "0507eac748d9a45edce2ff7ca534c08deeacd3ee4123fbf95cd4f9a59e59ad92"
    },
    "workflow_protocol": {
      "version": "impact-coordinator-v1",
      "discovery_instruction": "本阶段从固定原文及差异提出规则变化候选。只处理当前单元，可read补读。候选引用实际读取的原文；不是需求评审。依据不足保留evidence_insufficient和unresolved。",
      "case_instruction": "本阶段将rules中完整规则候选与当前完整固定用例及其编写来源比较。逐条返回candidate，key必须为对应rules.id，保留该规则的kind/summary及原文依据，case_impacts仅判断当前unit.id，每条说明none/minor/major/uncertain并引用当前用例实际字段。需要原文或来源时read补读。不得遗漏规则后声明analyzed；无法判断保留evidence_insufficient。discovery_units包含未完成范围时不能宣称完整或无变化。没有规则仍判断本用例来源是否充分。所有候选仍待评审，不能将模型建议当作部署事实或测试通过。",
      "sha256": "76f3c582a070c4b136e1e629ecdea508f0f1fe814e4a8dbd917180ca9051f5b5"
    },
