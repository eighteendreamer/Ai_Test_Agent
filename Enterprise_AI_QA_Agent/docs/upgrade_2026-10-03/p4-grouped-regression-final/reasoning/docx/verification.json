                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "BoundReadRequest": {
            "type": "object",
            "title": "BoundReadRequest",
            "properties": {
              "ranges": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundRangeRead"
                },
                "title": "Ranges",
