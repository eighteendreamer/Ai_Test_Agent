              },
              "case_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C[1-9][0-9]*$"
                },
                "title": "Case Refs",
                "maxItems": 100
              },
              "segment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^P[1-9][0-9]*$"
                },
                "title": "Segment Refs",
                "maxItems": 100
              },
              "difference_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^D[1-9][0-9]*$"
                },
                "title": "Difference Refs",
                "maxItems": 100
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCitation": {
            "type": "object",
            "title": "BoundCaseCitation",
            "required": [
