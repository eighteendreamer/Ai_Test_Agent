              "kind": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "uncertain"
                ],
                "type": "string",
                "title": "Kind"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "title": "Summary",
                "minLength": 1
              },
