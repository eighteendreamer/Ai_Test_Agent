                  "uncertain"
                ],
                "type": "string",
                "title": "Level"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "case_ref": {
                "type": "string",
                "title": "Case Ref",
                "pattern": "^C[1-9][0-9]*$"
              },
              "citations": {
                "type": "array",
                "items": {
