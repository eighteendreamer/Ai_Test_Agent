s\",\"id\":\"open-details\",\"role_name\":{\"name\":\"展开详情\",\"role\":\"button\"},\"testid\":null,\"text\":\"展开详情\",\"xpath\":\"/html/body[1]/main[1]/button[1]\"},\"role\":\"button\",\"shadow_path\":null,\"tag\":\"BUTTON\"},\"timestamp\":\"2026-10-08T12:58:42.992000\",\"type\":\"click\",\"value\":null},\"id\":\"a51b09f1-7d73-4a77-845f-07434664a4fb:0\",\"kind\":\"action\",\"label\":\"click #0\",\"occurred_at\":\"2026-10-08T12:58:42.992000\",\"resolution_status\":\"resolved\",\"seq\":0},{\"id\":\"ui_3347cf81c87744ea3241\",\"kind\":\"element\",\"label\":\"展开详情\"},{\"id\":\"ui_11d01ca8d111964e8380\",\"kind\":\"page\",\"label\":\"录制知识实际执行\",\"url\":\"http://127.0.0.1:60403/\"},{\"action_type\":\"page_response\",\"event\":{\"page\":{\"dpr\":1,\"recording_scope\":{\"document_id\":\"f5628b06911c497a95fdda56ea7debb8\",\"document_url\":\"http://127.0.0.1:60403/\",\"frame_id\":\"beedf861ff2f4709b2294fe76871b010\",\"frame_path\":[],\"local_seq\":1,\"page_id\":\"e0b04d1cd5914ce9ad5efc249ceab4c7\",\"parent_frame_id\":null},\"title\":\"录制知识实际执行\",\"url\":\"http://127.0.0.1:60403/\",\"viewport\":{\"h\":600,\"w\":800}},\"page_effect\":{\"dom_mutation_count\":2,\"response\":{\"action_local_seqs\":[0],\"association\":\"temporal_after_actions\",\"elements\":[{\"connected\":true,\"target\":{\"attributes\":{\"id\":\"details\"},\"in_iframe\":false,\"locators\":{\"css\":\"#details\",\"id\":\"details\",\"role_name\":{\"name\":\"已展开 DOM-f4e406da8736447b8b0d9e967d52c5be\",\"role\":null},\"testid\":null,\"text\":\"已展开 DOM-f4e406da8736447b8b0d9e967d52c5be\",\"xpath\":\"/html/body[1]/main[1]/section[1]\"},\"role\":null,\"shadow_path\":null,\"tag\":\"SECTION\"},\"text\":\"已展开 DOM-f4e406da8736447b8b0d9e967d52c5be\"}],\"max_actions\":100,\"max_nodes\":100,\"max_text_chars\":200,\"mutation_count\":2,\"observation_status\":\"observed_changes\",\"protocol\":\"recording-dom-response-v1\",\"reason\":\"settled\",\"scope\":\"document_light_dom\",\"snapshot_at\":\"observation_end\",\"truncated\":false,\"tr