ute or change official records.\",\"response_schema\":{\"$defs\":{\"DocumentImpactCaseCandidate\":{\"additionalProperties\":false,\"properties\":{\"citations\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactCaseCitation\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"},\"version_id\":{\"minLength\":1,\"title\":\"Version Id\",\"type\":\"string\"}},\"required\":[\"version_id\",\"level\",\"reason\",\"citations\"],\"title\":\"DocumentImpactCaseCandidate\",\"type\":\"object\"},\"DocumentImpactCaseCitation\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"title\":\"Path\",\"type\":\"array\"},\"root\":{\"default\":\"content_json\",\"enum\":[\"content_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"},\"version_id\":{\"title\":\"Version Id\",\"type\":\"string\"},\"version_record_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"title\":\"Version Record Sha256\",\"type\":\"string\"}},\"required\":[\"version_id\",\"version_record_sha256\",\"value\"],\"title\":\"DocumentImpactCaseCitation\",\"type\":\"object\"},\"DocumentImpactRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_id\":{\"title\":\"Source Id\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_id\",\"start_char\",\"end_char\"],\"title\":\"DocumentImpactRangeRead\",\"type\":\"object\"},\"DocumentImpactReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_version_ids\":{\"items\":{\"type\":\"string\"},\"maxItems\":100,\"title\":\"