xt\":true,\"transport\":\"local\"},\"project_id\":\"9cedd734-0128-4043-8a47-e247d20fe3fb\",\"version_id\":\"de669a83-feff-4bd8-973c-4596958c4495\"},\"sha256\":\"4773770eef01a6a4574b295d17fa6b31152fd4205d63480de9c5d9065b8e9826\",\"size_bytes\":2998,\"status\":\"complete\",\"storage_uri\":\"rustfs://qa-agent/document-parsing/9cedd734-0128-4043-8a47-e247d20fe3fb/9dab0157-df13-4ac3-9c01-4181769b3ce9/c91dc2ba-3808-465c-9c28-5922f3c61ee1/bc39d567-f0cb-4715-83fc-3d5fed45976a/result.json\",\"task_id\":\"9dab0157-df13-4ac3-9c01-4181769b3ce9\",\"warnings\":[]}},\"source_id\":\"455a59ab-3864-56a9-8bb7-9e9904252677\",\"source_type\":\"api_doc\",\"uri\":null,\"version\":\"de669a83-feff-4bd8-973c-4596958c4495\"},\"status\":\"available\"}]}],\"analysis_protocol\":{\"instruction\":\"Read primary and fixed evidence. Request more fixed ranges when cross-section rules are needed. Propose candidates with exact source slices and literal case JSON paths; report uncertain/missing evidence. Return one impact-response-v1 JSON object. For action=read request fixed reads, with no final candidates or outcome. For action=finish state the unit_outcome, candidates and unresolved evidence. Cite only exact text actually supplied in primary/additional_fixed_reads or earlier user messages; normalized diff offsets are not original offsets. Case impacts must cite a complete version actually supplied in this call history. Catalog metadata is not text evidence. Use fixed_case_catalog and fixed_difference_catalog identities to request additional fixed evidence. Applicability is only a suggestion; deployment remains unknown and all candidates require review. Do not claim complete project coverage from this unit. Do not execute or change official records.\",\"response_schema\":{\"$defs\":{\"DocumentImpactCaseCandidate\":{\"additionalProperties\":false,\"properties\":{\"citations\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactCaseCitation\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"},\"version_id\":{\"minLength\":1,\"title\":\"Version Id\",\"type\":\"string\"}},\"required\":[\"version_id\",\"level\",\"reason\",\"citations\"],\"title\":\"DocumentImpactCaseCandidate\",\"type\":\"object\"},\"DocumentImpactCaseCitation\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"title\":\"Path\",\"type\":\"array\"},\"root\":{\"default\":\"content_json\",\"enum\":[\"content_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"},\"version_id\":{\"title\":\"Version Id\",\"type\":\"string\"},\"version_record_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"title\":\"Version Record Sha256\",\"type\":\"string\"}},\"required\":[\"version_id\",\"version_record_sha256\",\"value\"],\"title\":\"DocumentImpactCaseCitation\",\"type\":\"object\"},\"DocumentImpactRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_id\":{\"title\":\"Source Id\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_id\",\"start_char\",\"end_char\"],\"title\":\"DocumentImpactRangeRead\",\"type\":\"object\"},\"DocumentImpactReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_version_ids\":{\"items\":{\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Version Ids\",\"type\":\"array\"},\"difference_ids\":{\"items\":{\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Ids\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_ids\":{\"items\":{\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Ids\",\"type\":\"array\"}},\"title\":\"DocumentImpactReadRequest\",\"type\":\"object\"},\"DocumentImpactRuleCandidate\":{\"additionalProperties\":false,\"properties\":{\"applicability_suggestion\":{\"default\":\"unknown\",\"enum\":[\"unknown\",\"current\",\"future\"],\"title\":\"Applicability Suggestion\",\"type\":\"string\"},\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactCaseCandidate\"},\"title\":\"Case Impacts\",\"type\":\"array\"},\"document_citations\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactTextCitation\"},\"minItems\":1,\"title\":\"Document Citations\",\"type\":\"array\"},\"key\":{\"minLength\":1,\"title\":\"Key\",\"type\":\"string\"},\"kind\":{\"enum\":[\"added\",\"modified\",\"removed\",\"uncertain\"],\"title\":\"Kind\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"DocumentImpactRuleCandidate\",\"type\":\"object\"},\"DocumentImpactTextCitation\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"quote\":{\"minLength\":1,\"title\":\"Quote\",\"type\":\"string\"},\"source_id\":{\"title\":\"Source Id\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"},\"text_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"title\":\"Text Sha256\",\"type\":\"string\"}},\"required\":[\"source_id\",\"text_sha256\",\"start_char\",\"end_char\",\"quote\"],\"title\":\"DocumentImpactTextCitation\",\"type\":\"object\"},\"DocumentImpactUnit\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"minLength\":1,\"title\":\"Id\",\"type\":\"string\"},\"kind\":{\"enum\":[\"segment\",\"case\",\"difference\"],\"title\":\"Kind\",\"type\":\"string\"}},\"required\":[\"kind\",\"id\"],\"title\":\"DocumentImpactUnit\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"$ref\":\"#/$defs/DocumentImpactRuleCandidate\"},\"title\":\"Candidates\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v1\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/DocumentImpactReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit\":{\"$ref\":\"#/$defs/DocumentImpactUnit\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"title\":\"Unit Outcome\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"unit\",\"action\",\"summary\"],\"title\":\"DocumentImpactDecision\",\"type\":\"object\"},\"scope\":\"one declared unit only\",\"sha256\":\"9dcdf38844e9c04b38273bd02a56e29dc9de005008927186025061235f5b6351\",\"version\":\"impact-call-v2\"},\"environment\":{\"deployment_status\":\"unknown\",\"environment_key\":\"声明环境\",\"provenance\":\"user_declared\",\"target_release\":\"尚无部署证据\"},\"fixed_case_catalog\":[{\"case_id\":\"130687b8-2f59-4b50-bf64-d1952e1be36b\",\"version_id\":\"cd8247f2-99c6-4157-a0c8-2c6558295855\"},{\"case_id\":\"284cb558-4526-4739-ba69-2f898d5e2839\",\"version_id\":\"b7281de9-19d8-47c4-a3bf-c4dc5fc67691\"},{\"case_id\":\"3e094b25-27ea-4e6a-aa2f-8b375c4d854d\",\"version_id\":\"e92fb8c9-318d-4c54-a864-812deb4d01c3\"}],\"fixed_difference_catalog\":[{\"id\":\"raw:0\",\"index\":0,\"kind\":\"raw\",\"sha256\":\"da384bfb28bde318cfa27a2676ef173a469100f02df2166070e12a440ed4fed1\"},{\"id\":\"raw:1\",\"index\":1,\"kind\":\"raw\",\"sha256\":\"50a8e4482a17b9bba31fa07385ee8e410b95f0d94