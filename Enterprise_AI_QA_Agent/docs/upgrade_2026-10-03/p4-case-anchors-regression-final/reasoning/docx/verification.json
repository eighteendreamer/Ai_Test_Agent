              },
              "verification_points": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Verification Points"
              }
            },
            "additionalProperties": false
          },
          "AnchoredRuleCandidate": {
            "type": "object",
            "title": "AnchoredRuleCandidate",
            "required": [
              "key",
              "kind",
              "summary",
              "reason",
              "document_citations"
            ],
            "properties": {
              "key": {
                "type": "string",
                "title": "Key",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "uncertain"
                ],
                "type": "string",
                "title": "Kind"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "title": "Summary",
                "minLength": 1
              },
              "case_impacts": {
                "type": "array",
                "items": {
