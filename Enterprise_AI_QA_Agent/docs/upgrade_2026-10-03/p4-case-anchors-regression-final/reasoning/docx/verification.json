                "type": "string",
                "title": "Root",
                "default": "content_json"
              },
              "value": {
                "title": "Value"
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCandidate": {
            "type": "object",
            "title": "BoundCaseCandidate",
            "required": [
              "case_ref",
