              },
              "start_char": {
                "type": "integer",
                "title": "Start Char",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "BoundReadRequest": {
            "type": "object",
            "title": "BoundReadRequest",
            "properties": {
              "ranges": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundRangeRead"
                },
                "title": "Ranges",
                "maxItems": 100
              },
              "case_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C[1-9][0-9]*$"
                },
                "title": "Case Refs",
                "maxItems": 100
              },
              "segment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^P[1-9][0-9]*$"
                },
                "title": "Segment Refs",
                "maxItems": 100
              },
              "difference_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^D[1-9][0-9]*$"
                },
                "title": "Difference Refs",
                "maxItems": 100
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCitation": {
            "type": "object",
            "title": "BoundCaseCitation",
            "required": [
              "value"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "title": "Path"
              },
              "root": {
                "enum": [
                  "content_json",
