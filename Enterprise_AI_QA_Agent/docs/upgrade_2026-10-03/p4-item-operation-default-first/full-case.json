{
  "objective": "查询第一条实际订单，保留未查询订单并在结束时清理全部本次记录",
  "requires": [
    "actual_order_id"
  ],
  "期望": {
    "code": 200,
    "flag": false,
    "count": 1,
    "nullable": null
  },
  "steps": [
    {
      "order": 1,
      "action": "读取项目需求和实际ID来源；没有ID需要先准备"
    },
    {
      "order": 2,
      "action": "确认准备两条记录且记录两个实际ID"
    },
    {
      "order": 3,
      "action": "GET第一条/orders/{id}"
    },
    {
      "order": 4,
      "action": "核对状态码200"
    },
    {
      "order": 5,
      "action": "核对flag为False"
    },
    {
      "order": 6,
      "action": "核对count为1"
    },
    {
      "order": 7,
      "action": "核对nullable为null并清理所有本次记录"
    },
    {
      "order": 8,
      "action": "LAST-DEFAULT-COVERAGE-STEP",
      "business": {
        "false": false,
        "zero": 0,
        "nullable": null
      }
    }
  ],
  "negative_condition": "没有订单ID时不得凭空推断，必须取得实际返回",
  "operations": {
    "query": "http://127.0.0.1:58100/orders/{id}"
  }
}