"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"AnchoredRuleCandidate\",\"type\":\"object\"},\"BoundCaseCandidate\":{\"additionalProperties\":false,\"properties\":{\"case_ref\":{\"pattern\":\"^C[1-9][0-9]*$\",\"title\":\"Case Ref\",\"type\":\"string\"},\"citations\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCitation\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"}},\"required\":[\"case_ref\",\"level\",\"reason\",\"citations\"],\"title\":\"BoundCaseCandidate\",\"type\":\"object\"},\"BoundCaseCitation\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"title\":\"Path\",\"type\":\"array\"},\"root\":{\"default\":\"content_json\",\"enum\":[\"content_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"}},\"required\":[\"value\"],\"title\":\"BoundCaseCitation\",\"type\":\"object\"},\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Refs\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/BoundRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_refs\":{\"items\":{\"pattern\":\"^P[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Refs\",\"type\":\"array\"}},\"title\":\"BoundReadRequest\",\"type\":\"object\"},\"BoundRuleCaseAssessment\":{\"additionalProperties\":false,\"properties\":{\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCandidate\"},\"minItems\":1,\"title\":\"Case Impacts\",\"type\":\"array\"},\"rule_ref\":{\"pattern\":\"^R[1-9][0-9]*$\",\"title\":\"Rule Ref\",\"type\":\"string\"}},\"required\":[\"rule_ref\",\"case_impacts\"],\"title\":\"BoundRuleCaseAssessment\",\"type\":\"object\"},\"GroupedEvidenceOutcome\":{\"additionalProperties\":false,\"properties\":{\"member_ref\":{\"pattern\":\"^[PD][1-9][0-9]*$\",\"title\":\"Member Ref\",\"type\":\"string\"},\"outcome\":{\"enum\":[\"analyzed\",\"evidence_insufficient\",\"unprocessed\"],\"title\":\"Outcome\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"member_ref\",\"outcome\",\"reason\"],\"title\":\"GroupedEvidenceOutcome\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/AnchoredRuleCandidate\"},{\"$ref\":\"#/$defs/BoundRuleCaseAssessment\"}]},\"title\":\"Candidates\",\"type\":\"array\"},\"evidence_outcomes\":{\"items\":{\"$ref\":\"#/$defs/GroupedEvidenceOutcome\"},\"maxItems\":100,\"title\":\"Evidence Outcomes\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v4\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/BoundReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"title\":\"Unit Outcome\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"action\",\"summary\"],\"title\":\"DocumentImpactGroupedWireDecision\",\"type\":\"object\"},\"scope\":\"one frozen reasoning task only\",\"sha256\":\"48a136981445bd39ff96760381eacb1f4ecd60f3c7e9d4959bc87e77d3fdf722\",\"version\":\"impact-call-v6\"},\"coordination_context\":{\"discovery_results\":[],\"discovery_task\":{\"id\":\"a21790871eff6948bce732de42e3675014861e717a363621a235cf78902cbb18\",\"members\":[{\"id\":\"parse:f392c39a-628d-410d-af91-12c6213ce92b:0:34\",\"kind\":\"segment\"},{\"id\":\"parse:71598771-efc9-4560-8d5a-4e52849fc361:0:34\",\"kind\":\"segment\"},{\"id\":\"raw:0\",\"kind\":\"difference\"},{\"id\":\"normalized:0\",\"kind\":\"difference\"},{\"id\":\"table:0\",\"kind\":\"difference\"}],\"read_bytes\":9320,\"reason_codes\":[],\"selection\":{\"case_version_ids\":[],\"difference_ids\":[\"raw:0\",\"normalized:0\",\"table:0\"],\"previous_call_id\":null,\"ranges\":[],\"retry_of_call_id\":null,\"segment_ids\":[\"parse:71598771-efc9-4560-8d5a-4e52849fc361:0:34\"],\"unit\":{\"id\":\"parse:f392c39a-628d-410d-af91-12c6213ce92b:0:34\",\"kind\":\"segment\"}}},\"discovery_units\":[],\"protocol\":{\"case_instruction\":\"对每条rules读取当前完整固定JSON、自身说明及已提供的编写来源。逐R引用返回当前用例影响与真实字段值；保留负向条件。discovery_results保留未完成范围，发现没有合法规则不能据此宣称无变化；没有规则也核对来源是否充分，缺少时保持依据不足。所有候选待评审，部署未知；evidence_outcomes为空，不重新提交文档发现。\",\"discovery_instruction\":\"从本次固定discovery_task组内全部原文与差异共同判断规则变化。返回一组规则候选及按成员顺序的逐证据outcome/reason；normalized用于辅助，原文引用选择T。本阶段不需要读取用例，不提前提交用例影响；组成功不能代替逐证据处理声明。\",\"sha256\":\"b99e6c1087d78f7ce47b7d33f0b80b7f7254a689350e235b9d4fb028926167