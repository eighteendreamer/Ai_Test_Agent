d\":\"parse:f392c39a-628d-410d-af91-12c6213ce92b\"}],\"analysis_protocol\":{\"instruction\":\"Return one impact-response-v4 JSON object. Follow the current coordination stage. Discovery: read every frozen discovery_task member, propose one set of rule changes citing T refs from fixed_text_evidence. For finish return evidence_outcomes in member order using P/D refs, with outcome and a specific reason for each member. Declare analyzed only after its complete evidence was supplied; insufficient/unprocessed must remain explicit. Never copy group success to every member. Case stage: compare every R rule with complete case JSON, execution_notes and its original sources; return rule_ref/case_impacts, literal paths and actual values; evidence_outcomes is empty. All formal identities/positions/hashes belong to the server. For read return only fixed P/S/C/D reads, no outcome, candidates or evidence_outcomes. Keep negative conditions. Catalogs are metadata, not read evidence. All proposals pending review; deployment unknown. No test execution or official-record changes.\",\"response_schema\":{\"$defs\":{\"AnchoredRuleCandidate\":{\"additionalProperties\":false,\"properties\":{\"applicability_suggestion\":{\"default\":\"unknown\",\"enum\":[\"unknown\",\"current\",\"future\"],\"title\":\"Applicability Suggestion\",\"type\":\"string\"},\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCandidate\"},\"title\":\"Case Impacts\",\"type\":\"array\"},\"document_citations\":{\"items\":{\"pattern\":\"^T[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Document Citations\",\"type\":\"array\"},\"key\":{\"minLength\":1,\"title\":\"Key\",\"type\":\"string\"},\"kind\":{\"enum\":[\"added\",\"modified\",\"removed\",\"uncertain\"],\"title\":\"Kind\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"AnchoredRuleCandidate\",\"type\":\"object\"},\"BoundCaseCandidate\":{\"additionalProperties\":false,\"properties\":{\"case_ref\":{\"pattern\":\"^C[1-9][0-9]*$\",\"title\":\"Case Ref\",\"type\":\"string\"},\"citations\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCitation\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"}},\"required\":[\"case_ref\",\"level\",\"reason\",\"citations\"],\"title\":\"BoundCaseCandidate\",\"type\":\"object\"},\"BoundCaseCitation\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"title\":\"Path\",\"type\":\"array\"},\"root\":{\"default\":\"content_json\",\"enum\":[\"content_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"}},\"required\":[\"value\"],\"title\":\"BoundCaseCitation\",\"type\":\"object\"},\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxI