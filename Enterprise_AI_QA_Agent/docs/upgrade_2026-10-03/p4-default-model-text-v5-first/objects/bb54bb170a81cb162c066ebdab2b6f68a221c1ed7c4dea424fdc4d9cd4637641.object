{"budget":{"canonical_input_bytes":20725,"content_tokens_or_estimate":18754,"encoding_name":null,"framing_allowance_tokens":1024,"implementation_version":"impact-content-budget-v1","input_estimated_tokens":19778,"method":"utf8_bytes_estimate","output_reserved_tokens":8192,"provider_token_measurement":"estimate","reserved_estimated_tokens":27970,"tokenizer_version":null},"implementation_version":"impact-call-input-v1","input_sha256":"563c96e1baea41425b849b0dfe3179e2a8473430b791d71808817f61b5f7dfa6","manifest_sha256":"e0b10e0eff3e94e4c3abe9213e0c17052fd78a38f2b707c325547d09104d0e53","request":{"messages":[{"content":"{\"additional_fixed_reads\":[],\"analysis_protocol\":{\"instruction\":\"Return one impact-response-v3 JSON object using this response_schema. The saved call owns the unit and formal identities. Use short S/P/C/D references for reads. In discovery, document_citations is a list of T references from fixed_text_evidence; select supplied original text, never calculate/copy offsets, quotes, UUIDs or hashes. The server binds each T to its exact original text/position/hash and verifies it. T entries are actual text evidence, other catalogs are retrieval metadata. For action=read supply reads with no final candidates/outcome; for finish provide unit_outcome/candidates/unresolved with no pending reads. During case_impacts return BoundRuleCaseAssessment: rule_ref R1 etc. plus case_impacts for every supplied fixed rule. The server retains each original rule and its citations. Case citations use literal JSON paths and actual values from a supplied complete case. Keep intentional negative conditions. Request fixed reads for missing/cross-section evidence. All candidates need review, deployment remains unknown; do not claim full coverage or execute/change official records. This schema defines the wire reply, canonical identities mentioned in coordination instructions belong to the server.\",\"response_schema\":{\"$defs\":{\"AnchoredRuleCandidate\":{\"additionalProperties\":false,\"properties\":{\"applicability_suggestion\":{\"default\":\"unknown\",\"enum\":[\"unknown\",\"current\",\"future\"],\"title\":\"Applicability Suggestion\",\"type\":\"string\"},\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCandidate\"},\"title\":\"Case Impacts\",\"type\":\"array\"},\"document_citations\":{\"items\":{\"pattern\":\"^T[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Document Citations\",\"type\":\"array\"},\"key\":{\"minLength\":1,\"title\":\"Key\",\"type\":\"string\"},\"kind\":{\"enum\":[\"added\",\"modified\",\"removed\",\"uncertain\"],\"title\":\"Kind\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"AnchoredRuleCandidate\",\"type\":\"object\"},\"BoundCaseCandidate\":{\"additionalProperties\":false,\"properties\":{\"case_ref\":{\"pattern\":\"^C[1-9][0-9]*$\",\"title\":\"Case Ref\",\"type\":\"string\"},\"citations\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCitation\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"}},\"required\":[\"case_ref\",\"level\",\"reason\",\"citations\"],\"title\":\"BoundCaseCandidate\",\"type\":\"object\"},\"BoundCaseCitation\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"title\":\"Path\",\"type\":\"array\"},\"root\":{\"default\":\"content_json\",\"enum\":[\"content_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"}},\"required\":[\"value\"],\"title\":\"BoundCaseCitation\",\"type\":\"object\"},\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Refs\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/BoundRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_refs\":{\"items\":{\"pattern\":\"^P[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Refs\",\"type\":\"array\"}},\"title\":\"BoundReadRequest\",\"type\":\"object\"},\"BoundRuleCaseAssessment\":{\"additionalProperties\":false,\"properties\":{\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCandidate\"},\"minItems\":1,\"title\":\"Case Impacts\",\"type\":\"array\"},\"rule_ref\":{\"pattern\":\"^R[1-9][0-9]*$\",\"title\":\"Rule Ref\",\"type\":\"string\"}},\"required\":[\"rule_ref\",\"case_impacts\"],\"title\":\"BoundRuleCaseAssessment\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/AnchoredRuleCandidate\"},{\"$ref\":\"#/$defs/BoundRuleCaseAssessment\"}]},\"title\":\"Candidates\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v3\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/BoundReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"title\":\"Unit Outcome\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"action\",\"summary\"],\"title\":\"DocumentImpactAnchoredDecision\",\"type\":\"object\"},\"scope\":\"one declared unit only\",\"sha256\":\"0507eac748d9a45edce2ff7ca534c08deeacd3ee4123fbf95cd4f9a59e59ad92\",\"version\":\"impact-call-v5\"},\"coordination_context\":{\"discovery_units\":[],\"protocol\":{\"case_instruction\":\"本阶段将rules中完整规则候选与当前完整固定用例及其编写来源比较。逐条返回candidate，key必须为对应rules.id，保留该规则的kind/summary及原文依据，case_impacts仅判断当前unit.id，每条说明none/minor/major/uncertain并引用当前用例实际字段。需要原文或来源时read补读。不得遗漏规则后声明analyzed；无法判断保留evidence_insufficient。discovery_units包含未完成范围时不能宣称完整或无变化。没有规则仍判断本用例来源是否充分。所有候选仍待评审，不能将模型建议当作部署事实或测试通过。\",\"discovery_instruction\":\"本阶段从固定原文及差异提出规则变化候选。只处理当前单元，可read补读。候选引用实际读取的原文；不是需求评审。依据不足保留evidence_insufficient和unresolved。\",\"sha256\":\"76f3c582a070c4b136e1e629ecdea508f0f1fe814e4a8dbd917180ca9051f5b5\",\"version\":\"impact-coordinator-v1\"},\"rules\":[],\"stage\":\"discover_rules\"},\"environment\":{\"deployment_status\":\"unknown\",\"environment_key\":\"声明环境\",\"provenance\":\"user_declared\",\"target_release\":\"尚无部署证据\"},\"fixed_case_catalog\":[{\"case_id\":\"0675989c-50d2-4275-a6b2-09d8db54bcde\",\"content_hash\":\"42ef7c277f706f9d26776687d9ba25e1a05f6d88393b65574b2e94090e61019c\",\"version_id\":\"12709291-91b0-4901-b5ca-522c5669459d\",\"version_record_sha256\":\"5819f875b64354c83fc3ff26962b2e8e739fc7ebe185072714167650a82c9621\"},{\"case_id\":\"0c07059c-c6ac-4f46-8c96-8e310742d05e\",\"content_hash\":\"5934149a42ba857ce845679ba6ab200c416226d9a1fe2694f986104ad886f7c2\",\"version_id\":\"7916e5ed-a6aa-46