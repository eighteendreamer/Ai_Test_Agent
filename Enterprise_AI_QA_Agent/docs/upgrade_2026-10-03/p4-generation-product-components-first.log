+                 {
+                   "type": "text",
+                   "text": "{\"objective\":\"只为指定已确认需求版本及验证点生成可评审JSON草稿。\",\"mode_key\":\"ui_testing\",\"max_cases\":1,\"evidence_context\":{\"generation_template\":{\"project_id\":\"c46adc55-556a-4284-9752-03d547d2650a\",\"scope_key\":\"global\",\"revision\":1,\"is_default\":true,\"content_hash\":\"41697dbdeee579a65ac7b08ce8547c8c84e9b4e16677a7e432439d27f2d7ae9c\",\"payload\":{\"name\":\"默认测试用例模板\",\"writing_guidance\":\"依据项目文档逐条编写可评审用例，覆盖正常、异常与边界条件。每条用例明确目标、前置条件、操作、预期结果和可观察验证点。负向条件必须保留。缺少业务依据时给出警告，禁止编造接口或元素。用例内容放入 content_json，JSON 结构可按项目调整；不要预先编译为测试模式的工具参数。\",\"execution_notes\":\"阅读完整用例内容，按目标、操作与预期执行并保存证据；步骤所需前置由项目依据确认，保留负向条件。\",\"example_json\":{\"objective\":\"验证示例业务行为\",\"preconditions\":[\"根据项目文档填写实际条件\"],\"steps\":[{\"order\":1,\"action\":\"执行有来源依据的操作\",\"expected\":\"可观察结果\"}],\"checkpoints\":[{\"description\":\"核对实际结果与需求一致\",\"evidence\":\"实际响应或页面证据\"}],\"test_data\":{},\"cleanup\":[]}}},\"source_refs\":[{\"source_type\":\"requirement_version\",\"source_id\":\"24656b33-aa03-4682-8163-a5bf2db59bcb\",\"version\":\"0a23d89e-d832-4df1-a6d2-56be114f0041\",\"label\":\"订单保留期\",\"metadata\":{\"content_sha256\":\"9362ef007a5c92a327d538caacf95b62b0868d623ecba7b39989f32e7e4b3ff0\",\"review_id\":\"54e24ee2-33f9-4025-8997-6a6492c73163\",\"snapshot_id\":\"e8749fec-9e23-43c9-84b0-e9bf6672561f\",\"input_sha256\":\"1c98b06d330da0d879dc97c93d0b5d01dd86e45b75ca793387bc9a8c46f979a4\"}},{\"source_type\":\"api_doc\",\"source_id\":\"00669678-d214-533b-a87b-2a1e695580f1\",\"version\":\"e563a415-e9f5-46d0-ada8-c791f8783ae2\",\"label\":\"\",\"uri\":null,\"metadata\":{\"content_asset_id\":\"9c9dfef4-d65a-4800-8640-2fd75244292c\",\"content_sha256\":\"1989b0b99e6fe7575a0fd6229227c6a8121f333094460914c05593aed5853e62\",\"parse_snapshot\":{\"created_at\":\"2026-10-05T06:09:31.944248Z\",\"dependency_versions\":{},\"id\":\"f1389edc-7503-4c52-a2a6-d8fa5136d8c6\",\"parser\":{\"available\":true,\"formats\":[\".md\",\".txt\"],\"implementation_version\":\"lightweight-v1\",\"ocr\":false,\"pars