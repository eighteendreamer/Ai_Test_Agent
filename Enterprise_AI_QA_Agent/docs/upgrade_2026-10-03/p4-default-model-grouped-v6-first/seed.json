              "minLength": 1
            },
            "summary": {
              "type": "string",
              "title": "Summary",
              "minLength": 1
            },
            "case_impacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BoundCaseCandidate"
              },
              "title": "Case Impacts"
