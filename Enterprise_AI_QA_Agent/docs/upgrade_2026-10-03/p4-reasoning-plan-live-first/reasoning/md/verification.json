    "response_protocol": {
      "version": "impact-call-v5",
      "scope": "one declared unit only",
      "response_schema": {
        "type": "object",
        "$defs": {
          "BoundRangeRead": {
            "type": "object",
            "title": "BoundRangeRead",
            "required": [
              "source_ref",
              "start_char",
              "end_char"
            ],
            "properties": {
              "end_char": {
                "type": "integer",
                "title": "End Char",
                "minimum": 0
              },
              "source_ref": {
                "type": "string",
                "title": "Source Ref",
                "pattern": "^S[1-9][0-9]*$"
              },
              "start_char": {
                "type": "integer",
                "title": "Start Char",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "BoundReadRequest": {
            "type": "object",
            "title": "BoundReadRequest",
            "properties": {
              "ranges": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundRangeRead"
                },
                "title": "Ranges",
                "maxItems": 100
              },
              "case_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^C[1-9][0-9]*$"
                },
                "title": "Case Refs",
                "maxItems": 100
              },
              "segment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^P[1-9][0-9]*$"
                },
                "title": "Segment Refs",
                "maxItems": 100
              },
              "difference_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^D[1-9][0-9]*$"
                },
                "title": "Difference Refs",
                "maxItems": 100
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCitation": {
            "type": "object",
            "title": "BoundCaseCitation",
            "required": [
              "value"
            ],
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "title": "Path"
              },
              "root": {
                "enum": [
                  "content_json",
                  "execution_notes"
                ],
                "type": "string",
                "title": "Root",
                "default": "content_json"
              },
              "value": {
                "title": "Value"
              }
            },
            "additionalProperties": false
          },
          "BoundCaseCandidate": {
            "type": "object",
            "title": "BoundCaseCandidate",
            "required": [
              "case_ref",
              "level",
              "reason",
              "citations"
            ],
            "properties": {
              "level": {
                "enum": [
                  "none",
                  "minor",
                  "major",
                  "uncertain"
                ],
                "type": "string",
                "title": "Level"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "case_ref": {
                "type": "string",
                "title": "Case Ref",
                "pattern": "^C[1-9][0-9]*$"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCitation"
                },
                "title": "Citations",
                "minItems": 1
              },
              "verification_points": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Verification Points"
              }
            },
            "additionalProperties": false
          },
          "AnchoredRuleCandidate": {
            "type": "object",
            "title": "AnchoredRuleCandidate",
            "required": [
              "key",
              "kind",
              "summary",
              "reason",
              "document_citations"
            ],
            "properties": {
              "key": {
                "type": "string",
                "title": "Key",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "added",
                  "modified",
                  "removed",
                  "uncertain"
                ],
                "type": "string",
                "title": "Kind"
              },
              "reason": {
                "type": "string",
                "title": "Reason",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "title": "Summary",
                "minLength": 1
              },
              "case_impacts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCandidate"
                },
                "title": "Case Impacts"
              },
              "uncertainties": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "title": "Uncertainties"
              },
              "document_citations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^T[1-9][0-9]*$"
                },
                "title": "Document Citations",
                "minItems": 1
              },
              "applicability_suggestion": {
                "enum": [
                  "unknown",
                  "current",
                  "future"
                ],
                "type": "string",
                "title": "Applicability Suggestion",
                "default": "unknown"
              }
            },
            "additionalProperties": false
          },
          "BoundRuleCaseAssessment": {
            "type": "object",
            "title": "BoundRuleCaseAssessment",
            "required": [
              "rule_ref",
              "case_impacts"
            ],
            "properties": {
              "rule_ref": {
                "type": "string",
                "title": "Rule Ref",
                "pattern": "^R[1-9][0-9]*$"
              },
              "case_impacts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/BoundCaseCandidate"
                },
                "title": "Case Impacts",
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "title": "DocumentImpactAnchoredDecision",
        "required": [
          "protocol_version",
          "action",
          "summary"
        ],
        "properties": {
