57-a6ca-194501bb95ca/17798418-d608-4e11-83b4-e88fca8fbbdd/7d1f3717-f0df-4694-bce0-62411bfde15d/result.json\",\"task_id\":\"80a25e49-2941-4657-a6ca-194501bb95ca\",\"warnings\":[{\"code\":\"docx_layout_scope\",\"message\":\"仅提取正文段落与表格；页码、页眉页脚、脚注、批注及视觉布局不在本解析器能力内。\",\"source\":null}]}}},\"evidence_id\":\"5bed7c03-2624-5919-88e4-f3f702052ef3:c01eebb4-e7a6-47b4-92d4-c1b14a10b749:e2edbac5-db88-4c1b-ad00-0a2ab184968b:7d1f3717-f0df-4694-bce0-62411bfde15d\",\"status\":\"available\",\"codes\":[]}],\"basis_limitations\":[\"source_warning:parse:7d1f3717-f0df-4694-bce0-62411bfde15d:docx_layout_scope\",\"source_warning:parse:164e87db-09a9-49db-8a13-f368456b303f:docx_layout_scope\",\"difference_warning:extracted_text_positions\",\"difference_warning:docx_layout_scope\",\"difference_warning:docx_layout_scope\"],\"deployment_status\":\"unknown\"}}}"}],"structured_messages":[{"role":"user","tool_call_id":null,"tool_calls":[],"parts":[{"type":"text","text":"{\"objective\":\"只为指定已确认需求版本及验证点生成可评审JSON草稿。\",\"mode_key\":\"ui_testing\",\"max_cases\":1,\"evidence_context\":{\"generation_template\":{\"project_id\":\"2661d502-1c67-414b-a252-fbd225d3dac3\",\"scope_key\":\"global\",\"revision\":1,\"is_default\":true,\"content_hash\":\"41697dbdeee579a65ac7b08ce8547c8c84e9b4e16677a7e432439d27f2d7ae9c\",\"payload\":{\"name\":\"默认测试用例模板\",\"writing_guidance\":\"依据项目文档逐条编写可评审用例，覆盖正常、异常与边界条件。每条用例明确目标、前置条件、操作、预期结果和可观察验证点。负向条件必须保留。缺少业务依据时给出警告，禁止编造接口或元素。用例内容放入 content_json，JSON 结构可按项目调整；不要预先编译为测试模式的工具参数。\",\"execution_notes\":\"阅读完整用例内容，按目标、操作与预期执行并保存证据；步骤所需前置由项目依据确认，保留负向条件。\",\"example_json\":{\"objective\":\"验证示例业务行为\",\"preconditions\":[\"根据项目文档填写实际条件\"],\"steps\":[{\"order\":1,\"action\":\"执行有来源依据的操作\",\"expected\":\"可观察结果\"}],\"checkpoints\":[{\"description\":\"核对实际结果与需求一致\",\"evidence\":\"实际响应或页面证据\"}],\"test_data\":{},\"cleanup\":[]}}},\"source_refs\":[{\"source_type\":\"requirement_version\",\"source_id\":\"89296ae0-29d0-4ccb-8baf-5c39ce665b06\",\"version\":\"b8b551b7-a4c2-431f-bf4e-06212d14a795