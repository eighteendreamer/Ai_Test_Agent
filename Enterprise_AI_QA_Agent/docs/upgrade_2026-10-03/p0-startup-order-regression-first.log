                    assert denied.status == 'denied' and denied.output['error'] == 'case_consumption_closure_conflict'
                    assert len(business[0][1]) == 4 and len(business[1]) == 1
                await action('cleanup-second','DELETE',business[0][0]+'/orders/'+second)
