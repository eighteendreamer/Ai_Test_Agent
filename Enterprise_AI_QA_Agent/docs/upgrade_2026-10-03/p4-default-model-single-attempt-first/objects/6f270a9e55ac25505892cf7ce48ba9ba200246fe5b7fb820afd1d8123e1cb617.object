ent_json\",\"execution_notes\"],\"title\":\"Root\",\"type\":\"string\"},\"value\":{\"title\":\"Value\"}},\"required\":[\"value\"],\"title\":\"BoundCaseCitation\",\"type\":\"object\"},\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Refs\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/BoundRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_refs\":{\"items\":{\"pattern\":\"^P[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Refs\",\"type\":\"array\"}},\"title\":\"BoundReadRequest\",\"type\":\"object\"},\"BoundRuleCaseAssessment\":{\"additionalProperties\":false,\"properties\":{\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/BoundCaseCandidate\"},\"minItems\":1,\"title\":\"Case Impacts\",\"type\":\"array\"},\"rule_ref\":{\"pattern\":\"^R[1-9][0-9]*$\",\"title\":\"Rule Ref\",\"type\":\"string\"}},\"required\":[\"rule_ref\",\"case_impacts\"],\"title\":\"BoundRuleCaseAssessment\",\"type\":\"object\"},\"GroupedEvidenceOutcome\":{\"additionalProperties\":false,\"properties\":{\"member_ref\":{\"pattern\":\"^[PD][1-9][0-9]*$\",\"title\":\"Member Ref\",\"type\":\"string\"},\"outcome\":{\"enum\":[\"analyzed\",\"evidence_insufficient\",\"unprocessed\"],\"title\":\"Outcome\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"member_ref\",\"outcome\",\"reason\"],\"title\":\"GroupedEvidenceOutcome\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/AnchoredRuleCandidate\"},{\"$ref\":\"#/$defs/BoundRuleCaseAssessment\"}]},\"title\":\"Candidates\",\"type\":\"array\"},\"evidence_outcomes\":{\"items\":{\"$ref\":\"#/$defs/GroupedEvidenceOutcome\"},\"maxItems\":100,\"title\":\"Evidence Outcomes\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v4\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/BoundReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Required non-null for finish: analyzed or evidence_insufficient. Null for read only.\",\"title\":\"Unit Outcome\"},\"unresolved\":{\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"action\",\"summary\"],\"title\":\"DocumentImpactGroupedWireDecision\",\"type\":\"object\"},\"scope\":\"one frozen reasoning task only\",\"sha256\":\"66a167b6da19d3fa4bc12e747010d40475dc8189c677af2551b67c37ae8c969d\",\"version\":\"impact-call-v6\"},\"coordination_context\":{\"discovery_results\":[{\"calls\":[\"50ee2d95-d6bb-4e97-8b2a-f6b19c1fb48b\"],\"candidates\":[{\"applicability_suggestion\":\"unknown\",\"case_impacts\":[],\"document_citations\":[{\"end_char\":46,\"quote\":\"已支付订单保留7天，超过保留期查询返回410。\\r\\n\",\"source_id\":\"parse:0b3de744-f261-440b-a9e0-109be13c0b4a\",\"start_char\":21,\"text_sha256\":\"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792\"},{\"end_char\":46,\"quote\":\"已支付订单保留9天，超过保留期查询返回410。\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":21,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"}],\"key\":\"order_retention_period_change\",\"kind\":\"modified\",\"reason\":\"旧文本规定“已支付订单保留7天”，新文本改为“已支付订单保留9天”，触发条件“超过保留期查询返回410”保持不变，属于规则值修改。\",\"summary\":\"已支付订单保留期从7天变更为9天\",\"uncertainties\":[]},{\"applicability_suggestion\":\"unknown\",\"case_impacts\":[],\"document_citations\":[{\"end_char\":56,\"quote\":\"## 优惠码\\r\\n\",\"source_id\":\"parse:0b3de744-f261-440b-a9e0-109be13c0b4a\",\"start_char\":48,\"text_sha256\":\"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792\"},{\"end_char\":81,\"quote\":\"提交有效优惠码PROMO5时订单金额减少5元。\\r\\n\",\"source_id\":\"parse:0b3de744-f261-440b-a9e0-109be13c0b4a\",\"start_char\":56,\"text_sha256\":\"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792\"},{\"end_char\":83,\"quote\":\"## 优惠码\\r\\n提交有效优惠码PROMO5时订单金额减少5元。\\r\\n\\r\\n\",\"source_id\":\"parse:0b3de744-f261-440b-a9e0-109be13c0b4a\",\"start_char\":48,\"text_sha256\":\"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792\"},{\"end_char\":139,\"quote\":\"# 订单服务需求\\r\\n\\r\\n## 订单保留\\r\\n已支付订单保留9天，超过保留期查询返回410。\\r\\n\\r\\n## 管理鉴权\\r\\n未登录访问GET /admin必须返回401，不得创建登录前置。\\r\\n\\r\\n## 订单导出\\r\\n新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":0,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"}],\"key\":\"promo_code_rule_removed\",\"kind\":\"removed\",\"reason\":\"旧文档存在独立“优惠码”章节及其规则文本，新文档全文中不再包含该章节或对应规则描述，属于整节移除。\",\"summary\":\"删除优惠码规则：提交有效优惠码PROMO5时订单金额减少5元\",\"uncertainties\":[]},{\"applicability_suggestion\":\"unknown\",\"case_impacts\":[],\"document_citations\":[{\"end_char\":102,\"quote\":\"## 订单导出\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":93,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"},{\"end_char\":139,\"quote\":\"新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":102,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"},{\"end_char\":139,\"quote\":\"\\r\\n## 订单导出\\r\\n新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":91,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"},{\"end_char\":139,\"quote\":\"## 订单导出\\r\\n新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671\",\"start_char\":93,\"text_sha256\":\"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9\"}],\"key\":\"order_export_rule_added\",\"kind\":\"added\",\"reason\":\"新版文档末尾新增“订单导出”章节，定义了GET /orders/export接口及结果排序要求；旧文档中无对应内容，属于新增规则。\",\"summary\":\"新增订单导出规则：GET /orders/export 导出订单按创建时间倒序排列\",\"uncertainties\":[]}],\"evidence_outcomes\":[{\"outcome\":\"analyzed\",\"reason\":\"提供旧版完整分块与章节文本，覆盖订单保留7天、优惠码、管理鉴权三节，解析状态complete，内容完整可用。\",\"unit\":{\"id\":\"parse:0b3de744-f261-440b-a9e0-109be13c0b4a:0:126\",\"kind\":\"segment\"}},{\"outcome\":\"analyzed\",\"reason\":\"提供新版完整分块与章节文本，覆盖订单保留9天、管理鉴权、订单导出三节，解析状态complete，内容完整可用。\",\"unit\":{\"id\":\"parse:a99999a4-0020-48b7-a2e5-837c3155b671:0:139\",\"kind\":\"segment\"}},{\"outcome\":\"analyzed\",\"reason\":\"raw差异显示原第4行“7”被替换为“9”，并删除从字符43到78的优惠码相关文本。\",\"unit\":{\"id\":\"raw:0\",\"kind\":\"difference\"}},{\"outcome\":\"analyzed\",\"reason\":\"raw差异显示在文档末尾（字符91至139）插入订单导出章节内容。\",\"unit\":{\"id\":\"raw:1\",\"kind\":\"difference\"}},{\"outcome\":\"analyzed\",\"reason\":\"normalized差异与raw:0一致，辅助确认同一保留天数修改与优惠码内容删除。\",\"unit\":{\"id\":\"normalized:0\",\"kind\":\"difference\"}},{\"outcome\":\"analyzed\",\"reason\":\"normalized差异与raw:1一致，辅助确认同一订单导出章节新增。\",\"unit\":{\"id\":\"normalized:1\",\"kind\":\"difference\"}},{\"outcome\":\"analyzed\",\"reason\":\"section差异显示旧section-3“优惠码”被删除，与raw删除范围对应。\",\"unit\":{\"id\":\"s