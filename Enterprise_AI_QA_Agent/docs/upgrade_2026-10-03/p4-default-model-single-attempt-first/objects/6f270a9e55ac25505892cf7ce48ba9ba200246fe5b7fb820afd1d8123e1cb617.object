4d04-9c06-ebf87212eb2e\",\"warnings\":[]}],\"fixed_text_evidence\":{\"T1\":{\"end_char\":126,\"quote\":\"# 订单服务需求\\r\\n\\r\\n## 订单保留\\r\\n已支付订单保留7天，超过保留期查询返回410。\\r\\n\\r\\n## 优惠码\\r\\n提交有效优惠码PROMO5时订单金额减少5元。\\r\\n\\r\\n## 管理鉴权\\r\\n未登录访问GET /admin必须返回401，不得创建登录前置。\\r\\n\",\"source_ref\":\"S1\",\"start_char\":0},\"T10\":{\"end_char\":139,\"quote\":\"# 订单服务需求\\r\\n\\r\\n## 订单保留\\r\\n已支付订单保留9天，超过保留期查询返回410。\\r\\n\\r\\n## 管理鉴权\\r\\n未登录访问GET /admin必须返回401，不得创建登录前置。\\r\\n\\r\\n## 订单导出\\r\\n新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_ref\":\"S2\",\"start_char\":0},\"T11\":{\"end_char\":10,\"quote\":\"# 订单服务需求\\r\\n\",\"source_ref\":\"S2\",\"start_char\":0},\"T12\":{\"end_char\":21,\"quote\":\"## 订单保留\\r\\n\",\"source_ref\":\"S2\",\"start_char\":12},\"T13\":{\"end_char\":46,\"quote\":\"已支付订单保留9天，超过保留期查询返回410。\\r\\n\",\"source_ref\":\"S2\",\"start_char\":21},\"T14\":{\"end_char\":57,\"quote\":\"## 管理鉴权\\r\\n\",\"source_ref\":\"S2\",\"start_char\":48},\"T15\":{\"end_char\":91,\"quote\":\"未登录访问GET /admin必须返回401，不得创建登录前置。\\r\\n\",\"source_ref\":\"S2\",\"start_char\":57},\"T16\":{\"end_char\":102,\"quote\":\"## 订单导出\\r\\n\",\"source_ref\":\"S2\",\"start_char\":93},\"T17\":{\"end_char\":139,\"quote\":\"新增GET /orders/export，导出订单按创建时间倒序排列。\\r\\n\",\"source_ref\":\"S2\",\"start_char\":102},\"T2\":{\"end_char\":10,\"quote\":\"# 订单服务需求\\r\\n\",\"source_ref\":\"S1\",\"start_char\":0},\"T3\":{\"end_char\":21,\"quote\":\"## 订单保留\\r\\n\",\"source_ref\":\"S1\",\"start_char\":12},\"T4\":{\"end_char\":46,\"quote\":\"已支付订单保留7天，超过保留期查询返回410。\\r\\n\",\"source_ref\":\"S1\",\"start_char\":21},\"T5\":{\"end_char\":56,\"quote\":\"## 优惠码\\r\\n\",\"source_ref\":\"S1\",\"start_char\":48},\"T6\":{\"end_char\":81,\"quote\":\"提交有效优惠码PROMO5时订单金额减少5元。\\r\\n\",\"source_ref\":\"S1\",\"start_char\":56},\"T7\":{\"end_char\":92,\"quote\":\"## 管理鉴权\\r\\n\",\"source_ref\":\"S1\",\"start_char\":83},\"T8\":{\"end_char\":126,\"quote\":\"未登录访问GET /admin必须返回401，不得创建登录前置。\\r\\n\",\"source_ref\":\"S1\",\"start