61-440b-a9e0-109be13c0b4a","start_char":21,"text_sha256":"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792"},{"end_char":46,"quote":"已支付订单保留9天，超过保留期查询返回410。\r\n","source_id":"parse:a99999a4-0020-48b7-a2e5-837c3155b671","start_char":21,"text_sha256":"bf3109a4a4dfd159cb678b663510ad35b58546b7f99d884b31f1f545642a99f9"}],"key":"d6bbb345ea92e84947d4283a4a5e01522537df0fcda1d7f03cd62f2a215474b8","kind":"modified","reason":"旧文本规定“已支付订单保留7天”，新文本改为“已支付订单保留9天”，触发条件“超过保留期查询返回410”保持不变，属于规则值修改。","summary":"已支付订单保留期从7天变更为9天","uncertainties":[]},{"applicability_suggestion":"unknown","case_impacts":[{"citations":[{"path":["objective"],"root":"content_json","value":"验证已支付订单超过7天不可查","version_id":"41e7ff81-cc2b-40dc-92eb-cfa0eac24f82","version_record_sha256":"188150f549e54413653454b13ec1e3bba5674033dc023fda48c4563eb09b681c"},{"path":["steps",7,"action"],"root":"content_json","value":"查询8天前已支付订单","version_id":"41e7ff81-cc2b-40dc-92eb-cfa0eac24f82","version_record_sha256":"188150f549e54413653454b13ec1e3bba5674033dc023fda48c4563eb09b681c"},{"path":["steps",7,"expected"],"root":"content_json","value":{"days":7,"status":410},"version_id":"41e7ff81-cc2b-40dc-92eb-cfa0eac24f82","version_record_sha256":"188150f549e54413653454b13ec1e3bba5674033dc023fda48c4563eb09b681c"},{"path":[],"root":"execution_notes","value":"阅读所有步骤，保留刻意缺失的负向条件。","version_id":"41e7ff81-cc2b-40dc-92eb-cfa0eac24f82","version_record_sha256":"188150f549e54413653454b13ec1e3bba5674033dc023fda48c4563eb09b681c"}],"level":"none","reason":"C1 完整 content_json 中的实际动作是环境信息记录和 8 天前已支付订单查询；objective、title、steps 与 expected 均未出现优惠码、PROMO5 或订单金额减少相关操作、条件与预期。R2 删除优惠码规则不改变 C1 现有验证点。","verification_points":[],"version_id":"41e7ff81-cc2b-40dc-92eb-cfa0eac24f82"}],"document_citations":[{"end_char":56,"quote":"## 优惠码\r\n","source_id":"parse:0b3de744-f261-440b-a9e0-109be13c0b4a","start_char":48,"text_sha256":"7acb94760bac15c53bd7df52c5acaa0773fbbeb75d0e119d87aa8a10848fa792"},{"end_char":81,"quote":"提交有效优惠码PROMO5时订单金额减少5元。\r\n","sour