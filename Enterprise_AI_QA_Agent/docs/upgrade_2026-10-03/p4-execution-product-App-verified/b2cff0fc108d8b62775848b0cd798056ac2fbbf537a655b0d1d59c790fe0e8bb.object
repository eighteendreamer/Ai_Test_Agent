rce\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2,1,1],\"start_line\":null},\"text\":\"9 天\"}]]}],\"new_ranges\":[{\"end_char\":33,\"end_line\":4,\"sources\":[{\"block_id\":\"block-3\",\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2],\"start_line\":null}}],\"start_char\":20,\"start_line\":3,\"text\":\"字段\\t约束\\n有效期\\t9 天\"}],\"old\":[{\"block_id\":\"block-3\",\"rows\":[[{\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2,0,0],\"start_line\":null},\"text\":\"字段\"},{\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2,0,1],\"start_line\":null},\"text\":\"约束\"}],[{\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2,1,0],\"start_line\":null},\"text\":\"有效期\"},{\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2,1,1],\"start_line\":null},\"text\":\"7 天\"}]]}],\"old_ranges\":[{\"end_char\":33,\"end_line\":4,\"sources\":[{\"block_id\":\"block-3\",\"source\":{\"end_line\":null,\"kind\":\"docx\",\"page\":null,\"part\":\"word/document.xml\",\"path\":[2],\"start_line\":null}}],\"start_char\":20,\"start_line\":3,\"text\":\"字段\\t约束\\n有效期\\t7 天\"}],\"operation\":\"replace\"},\"index\":0,\"kind\":\"table\",\"new_source_id\":\"parse:95caa72b-2f76-4c28-9556-71a39737ae88\",\"old_source_id\":\"parse:482f7147-b7db-4972-9be2-1321ac1f201b\"}],\"analysis_protocol\":{\"instruction\":\"Return one impact-response-v5 JSON object. Follow the current coordination stage. For finish, unit_outcome must be analyzed or evidence_insufficient, never null, and reads empty. Discovery: read every frozen discovery_task member, propose one set of rule changes with T refs from fixed_text_evidence; return evidence_outcomes in fixed P/D member order with a specific outcome/reason for every member. Never infer unread evidence was analyzed. Discovery has no case impacts. Case stage: assess every R rule for the current complete case identified by primary_ref, using its entire JSON, execution_notes, original sources and rule evidence. Return rule_ref/case_impacts for that current case; evidence_outcomes is empty. Other cases may be read as supplementary evidence, but each has its own analysis task; do not turn this call into whole-project coverage. Case citations are F strings from fixed_case_evidence for the stated case_ref. Each F selects a literal field path in the complete JSON or execution_notes; values are already in those complete reads. Do not output paths, values, UUIDs or hashes. Case metadata titles are not content_json fields. The server binds T/F selections to exact original positions/versions/paths/values and verifies them. For read request only needed fixed P/S/C/D reads with no candidates, evidence_outcomes or outcome. Other catalogs are retrieval metadata, not supplied evidence. Preserve deliberate negative conditions. unresolved contains only specific missing evidence that prevents CURRENT stage judgments, naming affected rules or members; use evidence_insufficient/uncertain where that evidence is needed. When the current analysis is complete, unresolved is empty. Do not put deployment unknown, pending review, preserved negative conditions, unchanged rules or separately assigned later tasks there just to restate their status. Keep those statements in summary, reasons and rule uncertainties. Existing source warnings remain explicit; never hide a gap affecting a judgment. All proposals pending review, deployment unknown. Do not execute tests or change official records.\",\"response_schema\":{\"$defs\":{\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Refs\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/BoundRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_refs\":{\"items\":{\"pattern\":\"^P[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Refs\",\"type\":\"array\"}},\"title\":\"BoundReadRequest\",\"type\":\"object\"},\"CaseAnchoredCandidate\":{\"additionalProperties\":false,\"properties\":{\"case_ref\":{\"pattern\":\"^C[1-9][0-9]*$\",\"title\":\"Case Ref\",\"type\":\"string\"},\"citations\":{\"items\":{\"pattern\":\"^F[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"}},\"required\":[\"case_ref\",\"level\",\"reason\",\"citations\"],\"title\":\"CaseAnchoredCandidate\",\"type\":\"object\"},\"CaseAnchoredRuleAssessment\":{\"additionalProperties\":false,\"properties\":{\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/CaseAnchoredCandidate\"},\"minItems\":1,\"title\":\"Case Impacts\",\"type\":\"array\"},\"rule_ref\":{\"pattern\":\"^R[1-9][0-9]*$\",\"title\":\"Rule Ref\",\"type\":\"string\"}},\"required\":[\"rule_ref\",\"case_impacts\"],\"title\":\"CaseAnchoredRuleAssessment\",\"type\":\"object\"},\"CaseAnchoredRuleCandidate\":{\"additionalProperties\":false,\"properties\":{\"applicability_suggestion\":{\"default\":\"unknown\",\"enum\":[\"unknown\",\"current\",\"future\"],\"title\":\"Applicability Suggestion\",\"type\":\"string\"},\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/CaseAnchoredCandidate\"},\"title\":\"Case Impacts\",\"type\":\"array\"},\"document_citations\":{\"items\":{\"pattern\":\"^T[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Document Citations\",\"type\":\"array\"},\"key\":{\"minLength\":1,\"title\":\"Key\",\"type\":\"string\"},\"kind\":{\"enum\":[\"added\",\"modified\",\"removed\",\"uncertain\"],\"title\":\"Kind\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"CaseAnchoredRuleCandidate\",\"type\":\"object\"},\"GroupedEvidenceOutcome\":{\"additionalProperties\":false,\"properties\":{\"member_ref\":{\"pattern\":\"^[PD][1-9][0-9]*$\",\"title\":\"Member Ref\",\"type\":\"string\"},\"outcome\":{\"enum\":[\"analyzed\",\"evidence_insufficient\",\"unprocessed\"],\"title\":\"Outcome\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"member_ref\",\"outcome\",\"reason\"],\"title\":\"GroupedEvidenceOutcome\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/CaseAnchoredRuleCandidate\"},{\"$ref\":\"#/$defs/CaseAnchoredRuleAssessment\"}]},\"title\":\"Candidates\",\"type\":\"array\"},\"evidence_outcomes\":{\"items\":{\"$ref\":\"#/$defs/GroupedEvidenceOutcome\"},\"maxItems\":100,\"title\":\"Evidence Outcomes\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v5\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/BoundReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Required non-null for finish: analyzed or evidence_insufficient. Null for read only.\",\"title\":\"Unit Outcome\"},\"unresolved\":{\"description\":\"Only specific missing evidence that prevents completing the CURRENT stage, naming affected rules or evidence members. Empty when current analysis is complete. Deployment unknown, pending review, intentional negative conditions, unchanged rules and separately assigned later tasks are not by themselves unresolved analysis gaps; retain those statements in summary/reasons/uncertainties.\",\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"action\",\"summary\"],\"title\":\"DocumentImpactCaseAnchoredDecision\",\"type\":\"object\"},\"scope\":\"one frozen reasoning task only\",\"sha256\":\"ecec8f8ec6bfca67b6ce856479eff401ef7df777847217381961ce6368a3ce38\",\"version\":\"impact-call-v7\"},\"coordination_context\":{\"discovery_results\":[],\"discovery_task\":{\"id\":\"3e6e0aba49fa9ea7d3e97cfd37a39481db08aec51c584c8b8f408c601a12e715\",\"members\":[{\"id\":\"parse:482f7147-b7db-4972-9be2-1321ac1f201b:0:34\",\"kind\":\"segment\"},{\"id\":\"parse:95caa72b-2f76-4c28-9556-71a39737ae88:0:34\",\"kind\":\"segment\"},{\"id\":\"raw:0\",\"kind\":\"difference\"},{\"id\":\"normalized:0\",\"kind\":\"difference\"},{\"id\":\"table:0\",\"kind\":\"difference\"}],\"read_bytes\":9320,\"reason_codes\":[],\"selection\":{\"case_version_ids\":[],\"difference_ids\":[\"raw:0\",\"normalized:0\",\"table:0\"],\"previous_call_id\":null,\"ranges\":[],\"retry_of_call_id\":null,\"segment_ids\":[\"parse:95caa72b-2f76-4c28-9556-71a39737ae88:0:34\"],\"unit\":{\"id\":\"parse:482f7147-b7db-4972-9be2-1321ac1f201b:0:34\",\"kind\":\"segment\"}}},\"discovery_units\":[],\"protocol\":{\"case_instruction\":\"对每条rules读取当前完整固定JSON、自身说明及已提供的编写来源。逐R引用返回当前用例影响与真实字段值；保留负向条件。discovery_results保留未完成范围，发现没有合法规则不能据此宣称无变化；没有规则也核对来源是否充分，缺少时保持依据不足。所有候选待评审，部署未知；evidence_outcomes为空，不重新提交文档发现。\",\"discovery_instruction\":\"从本次固定discovery_task组内全部原文与差异共同判断规则变化。返回一组规则候选及按成员顺序的逐证据outcome/reason；normalized用于辅助，原文引用选择T。本阶段不需要读取用例，不提前提交用例影响；组成功不能代替逐证据处理声明。\",\"sha256\":\"b99e6c1087d78f7ce47b7d33f0b80b7f7254a689350e235b9d4fb028926167fa\",\"version\":\"impact-coordinator-v2\"},\"reasoning_checkpoint\":{\"config_sha256\":\"4b4a61ecde5cd10f204146e3e5ea423a2583bc2d486ab1c6a28b8410df9c92ab\",\"created_at\":\"2026-10-06T00:45:06.616706Z\",\"input_sha256\":\"e180cadfa45ab24368a35e2984580079a4c638ed3a5a32bdb6ceec0cf8d74efa\",\"manifest_sha256\":\"7f4f1469d172fb0d38c7f4d66f56d35e38f0046a8a4fba59cc378f176bbb0e4c\",\"sha256\":\"39697795977ccdce995e56932ed24125bcf4e900507beefeb578884c85b1a8ed\",\"size_bytes\":1234,\"storage_uri\":\"rustfs://qa-agent/document-impacts/03d85767-08ec-4dfe-bfdb-df146a367b5f/56270344-4547-438d-9134-f0e72adca172/f5611793-6a5d-4580-88e3-00cd6688a115/calls/7e0d5058-3583-4eb7-8cdd-be3ee89d023c/reasoning-plan.json\",\"task_id\":\"56270344-4547-438d-9134-f0e72adca172\"},\"rules\":[],\"stage\":\"discover_rules\"},\"environment\":{\"deployment_status\":\"unknown\",\"environment_key\":\"qa\",\"provenance\":\"user_declared\",\"target_release\":\"future-release\"},\"fixed_case_catalog\":[{\"case_id\":\"3a8d2827-d9c3-44dc-98d6-ad652fcdebe9\",\"content_hash\":\"ecd92a60f21065fb7c8fba5b64681db8d8f1c69363d94aeb929500c8b2381fc5\",\"version_id\":\"f8be2ac2-d476-46a4-b7d4-4084cd5db458\",\"version_record_sha256\":\"8ceeb2ac2c78611677ea314ea92deb9113d155e079dccb6b0f2ec1148db3bc23\"}],\"fixed_case_evidence\":{},\"fixed_difference_catalog\":[{\"id\":\"raw:0\",\"index\":0,\"kind\":\"raw\",\"sha256\":\"d112f6246204b0585fd9a484af1c0a77a573afe2525056c424