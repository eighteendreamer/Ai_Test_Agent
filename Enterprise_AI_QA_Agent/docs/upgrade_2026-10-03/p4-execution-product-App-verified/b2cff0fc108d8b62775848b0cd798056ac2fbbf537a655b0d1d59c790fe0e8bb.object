d\":\"parse:482f7147-b7db-4972-9be2-1321ac1f201b\"}],\"analysis_protocol\":{\"instruction\":\"Return one impact-response-v5 JSON object. Follow the current coordination stage. For finish, unit_outcome must be analyzed or evidence_insufficient, never null, and reads empty. Discovery: read every frozen discovery_task member, propose one set of rule changes with T refs from fixed_text_evidence; return evidence_outcomes in fixed P/D member order with a specific outcome/reason for every member. Never infer unread evidence was analyzed. Discovery has no case impacts. Case stage: assess every R rule for the current complete case identified by primary_ref, using its entire JSON, execution_notes, original sources and rule evidence. Return rule_ref/case_impacts for that current case; evidence_outcomes is empty. Other cases may be read as supplementary evidence, but each has its own analysis task; do not turn this call into whole-project coverage. Case citations are F strings from fixed_case_evidence for the stated case_ref. Each F selects a literal field path in the complete JSON or execution_notes; values are already in those complete reads. Do not output paths, values, UUIDs or hashes. Case metadata titles are not content_json fields. The server binds T/F selections to exact original positions/versions/paths/values and verifies them. For read request only needed fixed P/S/C/D reads with no candidates, evidence_outcomes or outcome. Other catalogs are retrieval metadata, not supplied evidence. Preserve deliberate negative conditions. unresolved contains only specific missing evidence that prevents CURRENT stage judgments, naming affected rules or members; use evidence_insufficient/uncertain where that evidence is needed. When the current analysis is complete, unresolved is empty. Do not put deployment unknown, pending review, preserved negative conditions, unchanged rules or separately assigned later tasks there just to restate their status. Keep those statements in summary, reasons and rule uncertainties. Existing source warnings remain explicit; never hide a gap affecting a judgment. All proposals pending review, deployment unknown. Do not execute tests or change official records.\",\"response_schema\":{\"$defs\":{\"BoundRangeRead\":{\"additionalProperties\":false,\"properties\":{\"end_char\":{\"minimum\":0,\"title\":\"End Char\",\"type\":\"integer\"},\"source_ref\":{\"pattern\":\"^S[1-9][0-9]*$\",\"title\":\"Source Ref\",\"type\":\"string\"},\"start_char\":{\"minimum\":0,\"title\":\"Start Char\",\"type\":\"integer\"}},\"required\":[\"source_ref\",\"start_char\",\"end_char\"],\"title\":\"BoundRangeRead\",\"type\":\"object\"},\"BoundReadRequest\":{\"additionalProperties\":false,\"properties\":{\"case_refs\":{\"items\":{\"pattern\":\"^C[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Case Refs\",\"type\":\"array\"},\"difference_refs\":{\"items\":{\"pattern\":\"^D[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Difference Refs\",\"type\":\"array\"},\"ranges\":{\"items\":{\"$ref\":\"#/$defs/BoundRangeRead\"},\"maxItems\":100,\"title\":\"Ranges\",\"type\":\"array\"},\"segment_refs\":{\"items\":{\"pattern\":\"^P[1-9][0-9]*$\",\"type\":\"string\"},\"maxItems\":100,\"title\":\"Segment Refs\",\"type\":\"array\"}},\"title\":\"BoundReadRequest\",\"type\":\"object\"},\"CaseAnchoredCandidate\":{\"additionalProperties\":false,\"properties\":{\"case_ref\":{\"pattern\":\"^C[1-9][0-9]*$\",\"title\":\"Case Ref\",\"type\":\"string\"},\"citations\":{\"items\":{\"pattern\":\"^F[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Citations\",\"type\":\"array\"},\"level\":{\"enum\":[\"none\",\"minor\",\"major\",\"uncertain\"],\"title\":\"Level\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"verification_points\":{\"items\":{\"type\":\"string\"},\"title\":\"Verification Points\",\"type\":\"array\"}},\"required\":[\"case_ref\",\"level\",\"reason\",\"citations\"],\"title\":\"CaseAnchoredCandidate\",\"type\":\"object\"},\"CaseAnchoredRuleAssessment\":{\"additionalProperties\":false,\"properties\":{\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/CaseAnchoredCandidate\"},\"minItems\":1,\"title\":\"Case Impacts\",\"type\":\"array\"},\"rule_ref\":{\"pattern\":\"^R[1-9][0-9]*$\",\"title\":\"Rule Ref\",\"type\":\"string\"}},\"required\":[\"rule_ref\",\"case_impacts\"],\"title\":\"CaseAnchoredRuleAssessment\",\"type\":\"object\"},\"CaseAnchoredRuleCandidate\":{\"additionalProperties\":false,\"properties\":{\"applicability_suggestion\":{\"default\":\"unknown\",\"enum\":[\"unknown\",\"current\",\"future\"],\"title\":\"Applicability Suggestion\",\"type\":\"string\"},\"case_impacts\":{\"items\":{\"$ref\":\"#/$defs/CaseAnchoredCandidate\"},\"title\":\"Case Impacts\",\"type\":\"array\"},\"document_citations\":{\"items\":{\"pattern\":\"^T[1-9][0-9]*$\",\"type\":\"string\"},\"minItems\":1,\"title\":\"Document Citations\",\"type\":\"array\"},\"key\":{\"minLength\":1,\"title\":\"Key\",\"type\":\"string\"},\"kind\":{\"enum\":[\"added\",\"modified\",\"removed\",\"uncertain\"],\"title\":\"Kind\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"uncertainties\":{\"items\":{\"type\":\"string\"},\"title\":\"Uncertainties\",\"type\":\"array\"}},\"required\":[\"key\",\"kind\",\"summary\",\"reason\",\"document_citations\"],\"title\":\"CaseAnchoredRuleCandidate\",\"type\":\"object\"},\"GroupedEvidenceOutcome\":{\"additionalProperties\":false,\"properties\":{\"member_ref\":{\"pattern\":\"^[PD][1-9][0-9]*$\",\"title\":\"Member Ref\",\"type\":\"string\"},\"outcome\":{\"enum\":[\"analyzed\",\"evidence_insufficient\",\"unprocessed\"],\"title\":\"Outcome\",\"type\":\"string\"},\"reason\":{\"minLength\":1,\"title\":\"Reason\",\"type\":\"string\"}},\"required\":[\"member_ref\",\"outcome\",\"reason\"],\"title\":\"GroupedEvidenceOutcome\",\"type\":\"object\"}},\"additionalProperties\":false,\"properties\":{\"action\":{\"enum\":[\"read\",\"finish\"],\"title\":\"Action\",\"type\":\"string\"},\"candidates\":{\"items\":{\"anyOf\":[{\"$ref\":\"#/$defs/CaseAnchoredRuleCandidate\"},{\"$ref\":\"#/$defs/CaseAnchoredRuleAssessment\"}]},\"title\":\"Candidates\",\"type\":\"array\"},\"evidence_outcomes\":{\"items\":{\"$ref\":\"#/$defs/GroupedEvidenceOutcome\"},\"maxItems\":100,\"title\":\"Evidence Outcomes\",\"type\":\"array\"},\"protocol_version\":{\"const\":\"impact-response-v5\",\"title\":\"Protocol Version\",\"type\":\"string\"},\"reads\":{\"$ref\":\"#/$defs/BoundReadRequest\"},\"summary\":{\"minLength\":1,\"title\":\"Summary\",\"type\":\"string\"},\"unit_outcome\":{\"anyOf\":[{\"enum\":[\"analyzed\",\"evidence_insufficient\"],\"type\":\"string\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Required non-null for finish: analyzed or evidence_insufficient. Null for read only.\",\"title\":\"Unit Outcome\"},\"unresolved\":{\"description\":\"Only specific missing evidence that prevents completing the CURRENT stage, naming affected rules or evidence members. Empty when current analysis is complete. Deployment unknown, pending review, intentional negative conditions, unchanged rules and separately assigned later tasks are not by themselves unresolved analysis gaps; retain those statements in summary/reasons/uncertainties.\",\"items\":{\"type\":\"string\"},\"title\":\"Unresolved\",\"type\":\"array\"}},\"required\":[\"protocol_version\",\"action\",\"summary\"],\"title\":\"DocumentImpactCaseAnchoredDecision\",\"type\":\"object\"},\"scope\":\"one frozen reasoning task only\",\"sha256\":\"ecec8f8ec6bfca67b6ce856479eff401ef7df777847217381961ce6368a3ce38\",\"version\":\"impact-call-v7\"},\"coordination_context\":{\"discovery_results\":[],\"discovery_task\":{\"id\":\"3e6e0aba49fa9ea7d3e97cfd37a39481db08aec51c584c8b8f408c601a12e715\",\"members\":[{\"id\":\"parse:482f7147-b7db-4972-9be2-1321ac1f201b:0:34\",\"kind\":\"segment\"},{\"i